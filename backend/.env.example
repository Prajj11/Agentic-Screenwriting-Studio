# Gemini API Key (from AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Parallel API Key (for Research Agent)
PARALLEL_API_KEY=your_parallel_api_key_here

# Model Configuration
GEMINI_MAIN_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_TTS_MODEL=gemini-2.5-flash-tts
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database
SQLITE_DB_PATH=./data/scriptwriter.db

# Output directories
OUTPUT_IMAGES_DIR=./output/images
OUTPUT_AUDIO_DIR=./output/audio

# ClickHouse Vector Store (Partner Integration - Phase 3)
# Sign up at https://clickhouse.com/cloud for a free trial
CLICKHOUSE_HOST=your-clickhouse-host.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_DATABASE=default
